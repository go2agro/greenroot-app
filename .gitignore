# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Never commit SUPABASE_SERVICE_ROLE_KEY or ADMIN_SETUP_SECRET — server-side secrets only.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project documentation (internal use only - not for git)
PROJECT_MASTER_DOCUMENTATION.md
NAVIGATION_SYSTEM.md
lib/navigation/README.md
.env.local

# Cursor agent skills (local AI assistance only)
.claude/

# Setup reports and documentation
*-setup-report.md

# Cursor local config & codebase map
CODEBASE_MAP.md
.cursorrules

# Local schema export (dev backup only — not for git)
dev-schema.sql

# Supabase CLI link cache (regenerated by supabase link)
supabase/.temp/